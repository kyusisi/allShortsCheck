[Unit]
Description=All Shorts Check Node.js web service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/allshortscheck
EnvironmentFile=-/etc/allshortscheck.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
